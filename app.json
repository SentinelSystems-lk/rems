{
  "expo": {
    "name": "InsightsPV",
    "slug": "InsightsPV",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo/insightsPV-Logo-IOS.png",
    "splash": {
      "image": "./assets/images/Logo/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "scheme": "InsightsPV",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sentinelintelligencesystems.rems",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo/insightsPV-Logo-IOS.png",
        "backgroundColor": "#E6F4FE"
      },
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sentinelintelligencesystems.rems"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo/insightsPV-Logo-IOS.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo/logo.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/Logo/logo.png",
            "backgroundColor": "#000000"
          },
          "android": {
            "image": "./assets/images/Logo/logo.png",
            "backgroundColor": "#000000",
            "imageWidth": 150,
            "resizeMode": "contain"
          },
          "ios": {
            "image": "./assets/images/Logo/logo.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f446f3e2-106e-490e-aae2-62e3ce27a086"
      }
    }
  }
}
