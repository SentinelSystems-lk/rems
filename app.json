{
  "expo": {
    "name": "InsightsPV",
    "slug": "InsightsPV",
    "version": "2.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/Logo/insightsPV-Logo-IOS.png",
    "scheme": "InsightsPV",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sentinelintelligencesystems.rems",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo/insightsPV-Logo-IOS.png",
        "backgroundColor": "#E6F4FE"
      },
      "versionCode": 11,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sentinelintelligencesystems.rems"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo/insightsPV-Logo-IOS.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f446f3e2-106e-490e-aae2-62e3ce27a086"
      }
    }
  }
}
