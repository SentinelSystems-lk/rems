{
  "expo": {
    "name": "InsightsPV",
    "slug": "InsightsPV",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/Logo/logo.png",
    "scheme": "InsightsPV",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sentinelintelligencesystems.rems",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sentinelintelligencesystems.rems"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo/logo.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f446f3e2-106e-490e-aae2-62e3ce27a086"
      }
    }
  }
}
